# Copy to .env and fill. Never commit .env. Codex/agents must not read .env.

# OpenRouter — powers all LLM reasoning (v1 ModelRouter + v2 Codex provider).
# Only the four approved models are used; see config/agents.yaml and
# tradeloop/prompts/shared/model_routing.md.
OPENROUTER_API_KEY=

# Zerodha Kite — market data now, gated live orders later.
ZERODHA_ENABLE_TRADING=false
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Copy to .env manually if needed. Codex must not read .env.

# OpenRouter powers the Codex model provider (see scripts/run_cycle.sh).
OPENROUTER_API_KEY=

ZERODHA_ENABLE_TRADING=false
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

TRADELOOP_ROOT=tradeloop
TRADELOOP_DEFAULT_EXCHANGE=NSE
TRADELOOP_PAPER_CASH_INR=100000

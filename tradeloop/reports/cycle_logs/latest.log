def ema(values, n):
    k=2/(n+1)
    e=sum(values[:n])/n
    for v in values[n:]: e=v*k+e*(1-k)
    return e

def rsi(n=14):
    gains=[]; losses=[]
    for i in range(1,len(closes)):
        ch=closes[i]-closes[i-1]
        gains.append(max(ch,0)); losses.append(max(-ch,0))
    avg_gain=sum(gains[:n])/n; avg_loss=sum(losses[:n])/n
    for g,l in zip(gains[n:], losses[n:]):
        avg_gain=(avg_gain*(n-1)+g)/n
        avg_loss=(avg_loss*(n-1)+l)/n
    rs=avg_gain/avg_loss if avg_loss else float('inf')
    return 100-100/(1+rs)

def true_ranges():
    trs=[]
    prev=None
    for date,o,h,l,c,v in rows_ch:
        if prev is None: tr=h-l
        else: tr=max(h-l, abs(h-prev), abs(l-prev))
        trs.append(tr); prev=c
    return trs

def atr(n=14):
    trs=true_ranges()
    a=sum(trs[:n])/n
    for tr in trs[n:]: a=(a*(n-1)+tr)/n
    return a

def macd():
    e12=ema(closes,12); e26=ema(closes,26)
    macd_line=e12-e26
    # compute full macd sequence for signal
    def ema_seq(vals,n):
        k=2/(n+1); out=[]; e=None
        for i,v in enumerate(vals):
            if i==n-1: e=sum(vals[:n])/n; out.append(e)
            elif i>=n: e=v*k+e*(1-k); out.append(e)
        return out
    e12seq=ema_seq(closes,12); e26seq=ema_seq(closes,26)
